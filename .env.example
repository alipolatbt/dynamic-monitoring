# Copy this to .env and replace <username> with your Docker Hub username
# Full image references for production compose

# Docker Hub images (replace <username> with your actual Docker Hub username)
BACKEND_IMAGE=<username>/dynamic-monitoring-backend:1.0.0
FRONTEND_IMAGE=<username>/dynamic-monitoring-frontend:1.0.0

# Optional: override SMTP settings path inside backend container
# SMTP_SETTINGS_PATH=/data/smtp_settings.json
